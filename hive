[ "$_hive_loaded" ] && return 0
_hive_loaded=1

[ "$_hive-core_loaded" ] || {
    echo "hive: hive-core plugin not loaded — run: fly add f-atwi/hive-core" >&2
    return 1
}

_hive_usage()
{
    cat - <<'EOF'
usage: hive <subcommand> <target> [bash|zsh|ksh]

Canonical infrastructure hub — unified Fly transports for LXD, Juju, and Multipass.

  lxc       <container/vm>  [shell]   Fly shell in an LXD container or VM   (requires f-atwi/flexed)
  juju      <unit>       [shell]   Fly shell in a Juju unit                 (requires f-atwi/fujy)
  multipass <vm>         [shell]   Fly shell in a Multipass VM              (requires f-atwi/swarmpass)
  ssh       <host>       [shell]   Fly shell over SSH

  help                            Show this help

[shell] is optional: bash, zsh, or ksh  (default: inherited from target)
EOF
}


hive()
{
    typeset subcmd target shell

    subcmd="${1:-}"
    [ "$subcmd" ] || { _hive_usage; return 0; }
    target="${2:-}"
    shell="${3:-}"

    [ "$shell" ] && _fly_destshell="$shell"

    case "$subcmd" in
        lxc|juju|multipass|ssh)
            _fly_transport_run "$subcmd" "$target"
            ;;
        help|--help|-h)
            _hive_usage
            ;;
        *)
            echo "hive: unknown subcommand '$subcmd'" >&2
            _hive_usage >&2
            return 1
            ;;
    esac
}
